# Копия этого файла — backend/.env (в git не попадает). Значения ниже — НЕ секреты, только образцы.
# Реальные ключи и пароли сюда не пишите и в репозиторий не коммитьте.

# --- Основное ---------------------------------------------------------------
DEBUG=true
DATABASE_URL=sqlite:///hackathon.db
# postgresql+psycopg://user:password@host:5432/vko
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=*

# Секрет подписи токенов. ОБЯЗАТЕЛЬНО замените: `python -c "import secrets; print(secrets.token_urlsafe(48))"`
# (`python demo.py prepare` сделает это сам, если файла .env ещё нет).
JWT_SECRET=change-me-in-production-vko-2026
REQUIRE_MTLS=false

# --- Внешние источники и AI (необязательно) ------------------------------------
EXTERNAL_POLL_ENABLED=true          # для показа без интернета — false (demo.py делает это сам)
GENAI_TOKEN=
GENAI_MODEL=gemini-1.5-pro

# --- Демонстрационный режим (презентация) — см. docs/demo/ ---------------------
# Выключено по умолчанию: без DEMO_MODE маршрутов /api/demo/*, /live/* и /demo не существует.
DEMO_MODE=false
# Публичный показ: наружу — только демо-API и вход оператора; остальные API не подключаются.
# Сервер откажется стартовать с JWT_SECRET по умолчанию и паролями admin123/operator123.
DEMO_PUBLIC=false
# Адрес, который откроют зрители по QR-коду (пусто — берётся из адреса, по которому открыта панель).
DEMO_PUBLIC_URL=
# Учётная запись ведущего (роль operator). Пароль пусто — `demo.py prepare` сгенерирует и допишет сюда.
DEMO_OPERATOR_EMAIL=demo.operator@example.local
DEMO_OPERATOR_PASSWORD=
DEMO_VIEWER_TTL_MIN=240             # срок действия ссылки зрителя
DEMO_SESSION_TTL_MIN=480            # сессия живёт столько после последнего изменения
DEMO_MAX_SESSIONS=20
DEMO_MAX_VIEWERS=500                # одновременных потоков на процесс
DEMO_RATE_LIMIT_VIEWER=120          # запросов/мин с одного зрителя
DEMO_RATE_LIMIT_SESSION=6000        # запросов/мин от всех зрителей сессии
DEMO_RATE_LIMIT_OPERATOR=120        # запросов/мин с учётной записи ведущего
DEMO_LOGIN_RATE_LIMIT=20            # попыток входа/мин с одного IP
